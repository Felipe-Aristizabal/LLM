# === LLM Provider ===
MODEL_PROVIDER=gemini          # "gemini" | "ollama"
GEN_MODEL_ID=gemini-2.5-pro    # "gemini-2.5-flash-lite" | "gemini-flash-lite-latest"
OLLAMA_MODEL_ID=gemma3:4b      # "gemma3:270m"

# === Stuffing (límites y top-k) ===
MAX_CONTEXT_CHARS_ALL=60000    # Resumen/FAQ
MAX_CONTEXT_CHARS_QA=40000     # Q&A
DEFAULT_K_FILES_SUM=12         # archivos para Resumen
DEFAULT_K_FILES_FAQ=15         # archivos para FAQ  
DEFAULT_K_FILES_QA=15          # archivos para Q&A

# === Gemini (si usas provider=gemini) ===
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# --- Data ---
TQ_DATA_CLEAN_DIR=src/tecnoquimicas_kb/data/clean
TQ_DATA_RAW_DIR=src/tecnoquimicas_kb/data/raw
TQ_INDEX_DIR=src/tecnoquimicas_kb/index/faiss

# FAISS / embeddings
VECTOR_FAISS_INDEX=data/vector/faiss_index.faiss
VECTOR_FAISS_META=data/vector/faiss_meta.json
VECTOR_EMBEDDING_MODEL=intfloat/multilingual-e5-base
VECTOR_TOP_K=8
VECTOR_FETCH_K=20
VECTOR_USE_MMR=true
VECTOR_SCORE_THRESHOLD=0.0

# === Choose if the Agent would use the router ===
AGENT_USE_ROUTER=true
AGENT_ALLOW_COMPOSE=true
AGENT_MAX_HISTORY=15
AGENT_FOLLOWUP_LOOKBACK=4
